---
import Button from "../ui/Button.astro";
import Heading from "../ui/Heading.astro";
import Tools from "../portfolio/Tools.astro";
import { Icon } from "astro-icon/components";
import Hobbies from "../portfolio/Hobbies.astro";
import { getCollection } from "astro:content";

const [staticData] = await getCollection("staticData");
const {
  profileAlt,
  profileLink,
  profileImage,
  profileName,
  profileTitle,
  email,
  emailIconName,
  github,
  contactSectionButtonText,
} = staticData.data;

const baseUrl = import.meta.env.BASE_URL;
const portfolioImages = [
  { src: "/images/projects/finance-hub-1.jpg", alt: "Finance Hub dashboard – personal finance management app.", href: `${baseUrl}/portfolio/projects/finance-hub` },
  { src: "/images/projects/textops.png", alt: "TextOps – productivity and text automation tool.", href: `${baseUrl}/#projects` },
];
---

<section
  class="scroll-m-16 px-8 max-sm:px-4 py-8"
  id="home"
  aria-label="Professional profile and introduction"
>
  <div
    class="mx-auto mb-4 h-96 w-full max-w-7xl rounded-2xl bg-linear-to-r from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 hover:to-mint-300/30 dark:hover:to-mint-600/30 p-[.2rem] max-md:h-auto"
  >
    <div
      class="group relative z-0 flex h-full items-center justify-center gap-8 overflow-hidden rounded-2xl bg-linear-to-tr from-riptide-100 to-white p-4 transition-all hover:shadow-[0_10px_50px_rgba(59,130,246,0.2)] dark:bg-linear-to-r dark:from-mint-950 dark:to-zinc-950 dark:overflow-hidden max-md:w-full max-md:gap-3 max-lg:gap-2 max-sm:flex-col dark:before:bg-[radial-gradient(circle,rgba(59,130,246)_0,rgba(23,37,84)_100%)] before:bg-[radial-gradient(circle,rgba(147,197,253)_0,rgba(191,219,254)_100%)] before:absolute before:left-65 before:top-10 before:h-[40%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-80 before:-z-10 before:transition hover:before:animate-pulse"
    >
      <div class="relative aspect-[4/5] h-4/5 max-md:size-36">
        <!-- Decorative transparent layers at different angles -->
        <div
          class="absolute inset-0 z-0 rounded-2xl border border-riptide-300/40 dark:border-mint-400/30 bg-riptide-100/50 dark:bg-mint-500/10 -rotate-6 transition-transform duration-500 group-hover:rotate-[-4deg]"
          style="transform-origin: center center;"
          aria-hidden="true"
        />
        <div
          class="absolute inset-0 z-[1] rounded-2xl border border-mint-400/30 dark:border-riptide-400/20 bg-white/30 dark:bg-mint-950/40 rotate-3 -translate-x-1 translate-y-1 transition-transform duration-500 group-hover:rotate-[5deg] group-hover:translate-x-0 group-hover:translate-y-0"
          style="transform-origin: center center;"
          aria-hidden="true"
        />
        <!-- One layer overlapping at corner -->
        <div
          class="absolute -right-2 -top-2 z-[2] h-[70%] w-[70%] rounded-2xl border border-riptide-200/50 dark:border-mint-500/25 bg-riptide-50/60 dark:bg-mint-600/15 rotate-12 transition-transform duration-500 group-hover:rotate-[14deg]"
          style="transform-origin: bottom left;"
          aria-hidden="true"
        />
        <!-- Main profile image: rectangle so nothing important is cut -->
        <div
          class="group-hover:scale-[1.02] relative z-10 flex w-full cursor-pointer items-center overflow-hidden rounded-2xl border-2 border-riptide-200/60 dark:border-mint-500/40 p-[2px] shadow-lg transition-all duration-500"
        >
          <div class="relative z-20 flex w-full rounded-xl bg-mint-900 overflow-hidden">
            <div
              class="w-full aspect-[4/5] rounded-xl bg-center bg-cover"
              style={`background-image: url(${profileImage.startsWith('/') ? `${baseUrl}/${profileImage.slice(1)}` : `${baseUrl}/${profileImage}`})`}
              aria-label={profileAlt}
            >
              <a
                href={profileLink}
                class="flex h-full w-full"
                aria-label="View about me page"></a>
            </div>
          </div>
        </div>
      </div>

      <div
        class="flex h-full w-7/12 flex-col justify-center gap-4 p-4 max-md:w-full max-md:gap-2"
      >
        <span
          class="relative inline-flex items-center text-xs font-semibold leading-0 dark:text-white text-blacktext max-md:font-medium max-sm:justify-center"
        >
          <span
            class="before:mr-2 before:block before:h-1.5 before:w-1.5 before:rounded-full before:bg-blue-400 before:shadow-[0px_0px_0px_3px_rgba(59,130,246,0.5)] before:animate-pulse before:content-['']"
          ></span>
          Available for work
        </span>

        <h1
          class="text-4xl font-black leading-none text-blacktext dark:text-white max-xl:text-3xl max-lg:text-2xl max-sm:text-center"
        >
          {profileName} 👋
        </h1>
        <p
          class="mb-0 text-lg font-semibold leading-8 text-blacktext dark:text-gray-200 max-xl:text-base"
        >
          <span
            class="bg-linear-to-r from-riptide-500 to-mint-500 bg-clip-text font-black text-transparent dark:from-riptide-300 dark:to-mint-200"
            >{profileTitle}</span
          > with <span
            class="bg-linear-to-r from-riptide-500 to-mint-500 bg-clip-text font-black text-transparent dark:from-riptide-300 dark:to-mint-200"
            >4 years of experience</span
          >, passionate about software development 💻, technology ⚡, and dark coffee ☕ that fuels focus. I love tackling complex problems 🧩, building real systems 🚀, and keeping both mind 🧠 and body 💪 sharp with regular gym workouts.
        </p>

        <div class="flex gap-4 max-sm:flex-col max-sm:items-center">
          <Button
            link={"mailto:" + email}
            text={contactSectionButtonText}
            iconName={emailIconName}
          />
          <Button
            link={profileLink}
            text="About Me"
            iconName="person"
            variant="dark"
          />
        </div>
      </div>
    </div>
  </div>
  <div
    class="mx-auto grid max-w-7xl grid-cols-2 grid-rows-4 max-sm:gap-3 gap-4 max-md:h-[80vh] max-sm:h-[900px] max-xl:h-[550px] xl:h-[700px] md:grid-cols-4 md:grid-rows-2"
  >
    <div
      class="col-start-2 row-start-2 flex flex-col gap-3 rounded-2xl border border-blue-50 bg-linear-to-r from-riptide-200 to-mint-200 p-8 dark:border-zinc-800 dark:border-2 dark:bg-zinc-800 dark:bg-gradient-radial dark:from-riptide-500 dark:to-mint-500 max-md:gap-0 max-xl:p-5 max-md:p-4 max-lg:gap-1 md:col-start-4"
    >
      <div class="flex flex-col-reverse items-start gap-4 max-md:gap-2">
        <div class="flex items-center gap-4 max-md:gap-2">
          <Icon
            class="text-3xl dark:text-white text-mint-500 max-md:text-2xl max-sm:text-xl"
            name="heart"
            aria-hidden="true"
          />
          <Heading text="Beyond the Code" level={2} />
        </div>
      </div>

      <div class="overflow-y-auto">
        <Hobbies />
      </div>
    </div>

    <div
      class="col-start-1 row-start-2 rounded-2xl bg-linear-to-r from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 hover:to-mint-300/30 dark:hover:to-mint-600/30 p-[.2rem] transition-all ease-in duration-150 hover:scale-105 hover:shadow-[0_20px_50px_rgba(59,130,246,0.4)] z-40 md:col-start-3"
    >
      <div class="h-full w-full overflow-hidden rounded-2xl dark:bg-zinc-900">
        <div
          class="relative h-full w-full overflow-hidden rounded-2xl bg-linear-to-tr from-riptide-100 to-white dark:from-transparent dark:bg-linear-to-bl dark:to-transparent"
        >
          <a
            target="_blank"
            href={github}
            aria-label="View this site's code repository on GitHub"
          >
            <div
              class="relative flex h-full flex-col gap-8 p-8 dark:before:bg-[radial-gradient(circle,rgba(59,130,246)_0,rgba(23,37,84)_100%)] before:bg-[radial-gradient(circle,rgba(147,197,253)_0,rgba(191,219,254)_100%)] before:absolute before:left-30 before:bottom-30 before:h-[30%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-90 before:transition before:z-0 max-xl:p-5 max-md:p-4 xl:before:bottom-10"
            >
              <div class="z-2">
                <Heading text="Do you like this site's design?" level={3} />
              </div>

              <Icon
                class="absolute -bottom-10 left-30 size-50 text-mint-500/30 group-hover:animate-pulse ease-in-out max-sm:left-10 max-md:left-30 xl:size-56 xl:-bottom-5 xl:-right-24"
                name="github"
                aria-hidden="true"
              />
            </div>
          </a>
        </div>
      </div>
    </div>

    <div
      class="col-span-2 col-start-1 row-start-1 rounded-2xl bg-linear-to-r from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 hover:to-mint-300/30 dark:hover:to-mint-600/30 p-[.2rem] md:col-start-3"
    >
      <article
        class="group relative z-0 flex h-full w-full flex-col overflow-hidden rounded-2xl bg-linear-to-tr from-riptide-100 to-mint-100 p-6 transition hover:shadow-[0_10px_50px_rgba(59,130,246,0.2)] dark:bg-linear-to-r dark:from-mint-900 dark:to-mint-950 dark:overflow-hidden max-md:p-4 gap-6 max-md:gap-3 max-lg:gap-4 dark:before:bg-[radial-gradient(circle,rgba(59,130,246)_0,rgba(23,37,84)_100%)] before:bg-[radial-gradient(circle,rgba(147,197,253)_0,rgba(191,219,254)_100%)] before:absolute before:left-30 before:-bottom-0 before:h-[80%] before:aspect-square before:rounded-full before:blur-3xl dark:before:opacity-80 before:opacity-30 before:-z-10 before:transition"
      >
        <div class="flex items-center gap-4 max-md:gap-2">
          <Icon
            class="text-3xl dark:text-white text-mint-500 max-md:text-2xl max-sm:text-sm"
            name="dashboard"
            aria-hidden="true"
          />
          <Heading text="Tech" textGradient="Stack" level={3} />
        </div>
        <div class="overflow-y-auto">
          <Tools />
        </div>
      </article>
    </div>

    <div
      class="col-span-2 row-span-2 rounded-2xl bg-linear-to-r from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 p-[.2rem] hover:to-mint-300/30 dark:hover:to-mint-600/30 md:col-start-1 md:row-start-1"
    >
      <article
        class="group relative flex h-full flex-col justify-start overflow-hidden rounded-2xl bg-linear-to-br from-riptide-100 to-white dark:from-mint-950 dark:to-zinc-950 p-8 transition-all hover:shadow-[0_20px_50px_rgba(59,130,246,0.4)] max-md:p-6 dark:before:bg-[radial-gradient(circle,rgba(59,130,246)_0,rgba(23,37,84)_100%)] before:bg-[radial-gradient(circle,rgba(147,197,253)_0,rgba(191,219,254)_100%)] before:absolute before:left-1/2 before:bottom-30 before:h-[30%] before:aspect-square before:rounded-full before:blur-3xl before:opacity-70 before:transition before:-z-0 hover:before:animate-pulse xl:before:bottom-2/5"
      >
        <a
          href={`${baseUrl}/#projects`}
          class="absolute left-0 top-0 z-40 h-full w-full bg-transparent"
          aria-label="View projects section"></a>
        <div class="flex items-center gap-4 max-md:gap-2">
          <Icon
            class="text-3xl dark:text-white text-mint-500 max-md:text-2xl max-sm:text-xl"
            name="code"
            aria-hidden="true"
          />
          <Heading text="Projects" level={3} />
        </div>
        <p
          class="z-2 my-4 text-lg font-semibold leading-6 dark:text-gray-200 text-blacktext max-xl:text-base max-w-[90%] max-md:max-w-[85%]"
        >
          I enjoy <span
            class="bg-linear-to-r from-riptide-500 to-mint-500 bg-clip-text font-black text-transparent dark:from-riptide-300 dark:to-mint-200"
            >bringing ideas to life through code.</span
          >
          <br /> Here you can explore some of the <span
            class="bg-linear-to-r from-riptide-500 to-mint-500 bg-clip-text font-black text-transparent dark:from-riptide-300 dark:to-mint-200"
            >projects</span
          > I've crafted, combining technology, design, and creativity.
          <span
            class="bg-linear-to-r from-riptide-500 to-mint-500 font-black bg-clip-text text-transparent dark:from-riptide-300 dark:to-mint-200"
            >Take a look!</span
          >
        </p>
        <!-- Project previews: fill available space, full rectangles + transparent angled layers -->
        <div class="relative z-0 mt-4 flex min-h-0 flex-1 flex-col gap-4 sm:flex-row sm:gap-6">
          <!-- Decorative transparent layers behind the cards -->
          <div
            class="absolute left-0 top-0 z-0 h-[90%] w-[48%] rounded-2xl border border-riptide-300/35 dark:border-mint-400/25 bg-riptide-100/40 dark:bg-mint-500/10 -rotate-3 max-sm:w-[92%] max-sm:left-2"
            aria-hidden="true"
          />
          <div
            class="absolute right-0 top-0 z-0 h-[92%] w-[48%] rounded-2xl border border-mint-400/30 dark:border-riptide-400/20 bg-white/25 dark:bg-mint-950/30 rotate-2 translate-x-1 max-sm:w-[92%] max-sm:right-2 max-sm:left-auto"
            aria-hidden="true"
          />
          <div
            class="absolute -right-3 top-2 z-[1] h-[80%] w-[44%] rounded-2xl border border-riptide-200/45 dark:border-mint-500/20 bg-riptide-50/50 dark:bg-mint-600/10 rotate-6 max-sm:hidden"
            aria-hidden="true"
          />
          <a
            href={portfolioImages[0].href}
            class="group/card relative z-10 flex min-h-0 min-w-0 flex-[1.1] flex-col overflow-hidden rounded-2xl border-2 border-zinc-200/60 bg-zinc-100/80 dark:bg-zinc-800/80 shadow-lg transition-all duration-300 ease-out hover:scale-[1.02] hover:border-mint-400/40 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-mint-400/50 focus:ring-offset-2 dark:border-zinc-700/60 dark:hover:border-mint-500/40 dark:focus:ring-offset-zinc-900"
            aria-label={portfolioImages[0].alt}
          >
            <div class="flex min-h-[180px] flex-1 items-center justify-center p-1.5 sm:min-h-[220px] sm:p-2 md:min-h-[240px] xl:min-h-[260px]">
              <img
                src={portfolioImages[0].src.startsWith('/') ? `${baseUrl}${portfolioImages[0].src}` : `${baseUrl}/${portfolioImages[0].src}`}
                alt={portfolioImages[0].alt}
                loading="lazy"
                width="520"
                height="280"
                class="max-h-full w-full object-contain rounded-lg"
              />
            </div>
          </a>
          <a
            href={portfolioImages[1].href}
            class="group/card relative z-10 flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-2xl border-2 border-zinc-200/60 bg-zinc-100/80 dark:bg-zinc-800/80 shadow-lg transition-all duration-300 ease-out hover:scale-[1.02] hover:border-mint-400/40 hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-mint-400/50 focus:ring-offset-2 dark:border-zinc-700/60 dark:hover:border-mint-500/40 dark:focus:ring-offset-zinc-900"
            aria-label={portfolioImages[1].alt}
          >
            <div class="flex min-h-[180px] flex-1 items-center justify-center p-1.5 sm:min-h-[220px] sm:p-2 md:min-h-[240px] xl:min-h-[260px]">
              <img
                src={portfolioImages[1].src.startsWith('/') ? `${baseUrl}${portfolioImages[1].src}` : `${baseUrl}/${portfolioImages[1].src}`}
                alt={portfolioImages[1].alt}
                loading="lazy"
                width="400"
                height="280"
                class="max-h-full w-full object-contain rounded-lg"
              />
            </div>
          </a>
        </div>
        <!-- Fill bottom: quick links so the card doesn’t feel empty (z-50 above overlay) -->
        <div class="relative z-50 mt-4 flex flex-wrap items-center gap-3 border-t border-zinc-200/50 dark:border-zinc-700/50 pt-4 max-md:mt-3 max-md:pt-3">
          <a
            href={`${baseUrl}/#projects`}
            class="text-sm font-semibold text-riptide-600 dark:text-mint-400 hover:underline focus:outline-none focus:ring-2 focus:ring-mint-400/50 focus:ring-offset-2 dark:focus:ring-offset-zinc-900 rounded"
          >
            View all projects →
          </a>
          <span class="text-zinc-300 dark:text-zinc-600" aria-hidden="true">·</span>
          <span class="text-sm text-zinc-500 dark:text-zinc-400">React · Node · TypeScript</span>
        </div>
      </article>
    </div>
  </div>
</section>
