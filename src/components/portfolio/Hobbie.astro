---
import { Icon } from "astro-icon/components";
import { getHobbyIconName } from "../../utils/hobbies";

const { tag } = Astro.props;
const iconName = getHobbyIconName(tag);
---

<span
    class="flex items-center gap-2 px-4 py-1 rounded-full text-sm font-medium text-zinc-500 dark:text-neutral-400 hover:text-blacktext bg-riptide-50 dark:bg-zinc-800 hover:bg-mint-200 cursor-default transition-all ease-in-out duration-300 w-fit"
>
  <Icon class="size-4 shrink-0" name={iconName} aria-hidden="true" />
  {tag}
</span>
